# Authored code and configuration: classify the real files, not frameworks.
*.py linguist-language=Python linguist-detectable=true
app/static/js/*.jsx linguist-language=JavaScript linguist-detectable=true
app/static/js/*.js linguist-language=JavaScript linguist-detectable=true
app/static/css/*.css linguist-language=CSS linguist-detectable=true
app/static/index.html linguist-language=HTML linguist-detectable=true
*.sh linguist-language=Shell linguist-detectable=true
*.bat linguist-language=Batchfile linguist-detectable=true
Dockerfile linguist-language=Dockerfile linguist-detectable=true

# These are real data/configuration languages, normally omitted by Linguist.
docker-compose.yml linguist-language=YAML linguist-detectable=true
alembic.ini linguist-language=INI linguist-detectable=true
app/static/manifest.json linguist-language=JSON linguist-detectable=true

# Downloaded dependencies are not authored application source.
app/static/vendor/** linguist-vendored=true
