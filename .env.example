# Copie este arquivo para ".env" e ajuste conforme seu ambiente.
# (Em producao, defina estas variaveis no servidor, nunca versione o .env real.)

# --- Banco de dados ---
# SQLite (padrao, desenvolvimento) — deixe comentado para usar o arquivo local:
# DATABASE_URL=sqlite:///./rh_ats.db
#
# PostgreSQL (producao) — descomente e ajuste usuario/senha/host/porta/banco:
# DATABASE_URL=postgresql+psycopg://rh_user:senha_forte@localhost:5432/rh_ats

# --- Seguranca ---
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
TOKEN_EXPIRE_MIN=480
